# Copy to .env (never commit .env)

# Owner role: migrations, grants, seed
DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil

# Restricted role the API connects as (no UPDATE/DELETE on audit_log)
APP_DATABASE_URL=postgres://vigil_app:vigil_app@localhost:5432/vigil

# Integration tests run against a separate database
TEST_DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil_test

# Used from step 2 onward
JWT_SECRET=change-me-to-a-long-random-string
SERVICE_KEY=change-me-service-key-for-ingest
CORS_ORIGIN=http://localhost:8080
ML_SCORE_URL=